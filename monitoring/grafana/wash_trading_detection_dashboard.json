      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(ledgerlens_event_bus_dead_letter_oldest_age_seconds)",
          "legendFormat": "oldest age",
          "range": true,
          "refId": "A"
        }
      ]
    }
  ],
