{
  "name": "@ledgerlens/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the LedgerLens API with Zod runtime validation",
  "keywords": [
    "ledgerlens",
    "stellar",
    "risk-scoring",
    "compliance",
    "wash-trading"
  ],
  "homepage": "https://github.com/Ledger-Lenz/Ledgerlens-core#readme",
  "license": "MIT",
  "author": "LedgerLens",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic-usage.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:types": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run format:check && npm run build && npm run test"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.12.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0",
    "tsx": "^4.7.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
