{
  "consumer": {
    "name": "ledgerlens-sdk-rust"
  },
  "provider": {
    "name": "ledgerlens-api"
  },
  "interactions": [
    {
      "description": "get_wallet_scores returns latest scores",
      "providerState": "a risk score exists for wallet GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "request": {
        "method": "GET",
        "path": "/v1/scores/GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      },
      "response": {
        "status": 200,
        "body": {
          "scores": [
            {
              "wallet": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
              "asset_pair": "XLM/USDC",
              "score": 85,
              "benford_flag": true,
              "ml_flag": true,
              "confidence": 90,
              "disputed": false,
              "timestamp": "2024-05-01T12:00:00Z"
            }
          ],
          "cross_chain_links": []
        }
      }
    },
    {
      "description": "get_wallet_scores on unknown wallet returns 404",
      "providerState": "no risk score exists for wallet GBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
      "request": {
        "method": "GET",
        "path": "/v1/scores/GBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "list_scores lists risk scores",
      "providerState": "a risk score exists for wallet GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "request": {
        "method": "GET",
        "path": "/v1/scores"
      },
      "response": {
        "status": 200,
        "body": [
          {
            "wallet": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "asset_pair": "XLM/USDC",
            "score": 85,
            "benford_flag": true,
            "ml_flag": true,
            "confidence": 90,
            "disputed": false,
            "timestamp": "2024-05-01T12:00:00Z"
          }
        ]
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "2.0.0"
    },
    "matching": "type: response bodies match by shape (keys present, JSON types equal); arrays match on their first element"
  }
}
